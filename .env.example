# Copy to .env.local (never commit .env.local).

# Contact form — Resend (https://resend.com). Free tier is enough.
# If RESEND_API_KEY is missing, the form falls back to a prefilled mailto: link.
RESEND_API_KEY=
# Where contact messages are delivered. Defaults to the email in src/content/profile.ts.
CONTACT_TO=
# Sender. Resend's sandbox sender "onboarding@resend.dev" only delivers to the
# email on your Resend account; set a verified-domain address for anything else.
CONTACT_FROM=

# Canonical site URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://portfolio-alpha-orpin-15.vercel.app

# Optional: raises the GitHub API rate limit for the build-time repo widget.
GITHUB_TOKEN=
